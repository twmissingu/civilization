{
  "name": "civilization",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "文明6 开源复现 - Web 端回合制 4X 策略游戏（TS + PixiJS + React + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "check:purity": "node scripts/check-purity.mjs",
    "check": "npm run check:purity && npm run check:depcruise && npm run test:coverage"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "pixi.js": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplex-noise": "^4.0.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "dependency-cruiser": "^16.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
